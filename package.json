{
  "name": "siyuan-cloud",
  "version": "0.7.2",
  "type": "module",
  "description": "A cloud-drive aggregation manager for SiYuan: mount 25+ cloud drives and disks, preview 300+ formats, work with SiYuan Reader/Media Player, share online, insert file links, and use cloud files as image/video beds without filling your workspace.",
  "author": "mm-o",
  "license": "MIT",
  "homepage": "https://github.com/mm-o/siyuan-cloud",
  "repository": "https://github.com/mm-o/siyuan-cloud",
  "scripts": {
    "dev": "vite build --watch",
    "dev:kernel": "node ./scripts/build-kernel.mjs --watch --out-dir=dev",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "release:with-docs": "pnpm docs:feishu && node ./release.js",
    "build": "vite build",
    "docs:feishu": "node ./scripts/feishu-doc-sync.mjs",
    "test:kernel": "node ./scripts/kernel-route-smoke.mjs",
    "test:preview-modules": "node --experimental-strip-types ./scripts/preview-modules-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "vue": "^3.3.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@types/node": "^20.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@zip.js/zip.js": "^2.8.26",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "fast-glob": "^3.2.12",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.62.1",
    "siyuan": "1.1.0",
    "typescript": "^5.0.4",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^0.15.0",
    "vite-plugin-zip-pack": "^1.0.5"
  }
}
